{
  "_comment": "Sanitized copy of the server config used on one RX 6900 XT (gfx1030) + 64 GB RAM box, 2026-10-26. Replace every <...> placeholder. Paths, model names and the tokenizer path were removed.",
  "exe": "<build-dir>/bin/strata",
  "backend": "hip",
  "port": 18090,
  "cwd": "<strata-source-tree>",
  "args": [
    "--pack", "<models>/SC117-IQ3_XXS/pack-strata-v0142",
    "--native", "<models>/SC117-IQ3_XXS/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-IQ3_XXS-00001-of-00002.gguf",
    "--native-dense-gguf", "<models>/SC117-IQ3_XXS/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-IQ3_XXS-00001-of-00002.gguf",
    "--native-dense-gguf", "<models>/SC117-IQ3_XXS/IQ3_XXS/Qwen3.8-Flash-Next-GSQ-RCO-abliterated-IQ3_XXS-00002-of-00002.gguf",
    "--ple-gguf", "<models>/<PLE-table>.gguf",
    "--expert-profile", "<strata-0.1.40.1-tree>/data/expert-profile.bin",
    "--mtp", "<models>/<mtp-runtime-dir>",
    "--mtp-draft-vocab", "<draft-vocab-ko>.bin",
    "--expert-cache", "auto",
    "--vram-reserve-mib", "512",
    "--mmap-experts",
    "--prefill", "auto:32768",
    "--max-context", "262144",
    "--kv", "k8v4",
    "--spec", "4",
    "--spec-min-p", "0.7",
    "--mtp-window", "8192",
    "--adapt-every", "4",
    "--adapt-decay", "0.7",
    "--adapt-swaps", "96",
    "--short-read", "0",
    "--vision"
  ],
  "env": {
    "LD_LIBRARY_PATH": "<rocm10-gfx103X>/install/lib",
    "STRATA_ROCBLAS_TUNING": "<strata-source-tree>/tools/hip",
    "STRATA_HIP_PROMPT_F16": "1",
    "STRATA_HIP_PROMPT_F16_MIN_PROMPT": "8192",
    "STRATA_SELECT_SIMT": "1",
    "STRATA_PROMPT_ATTN_RDNA2": "1",
    "STRATA_IQ_MT_MIN": "1",
    "STRATA_VERIFY_COHERENT": "1",
    "STRATA_VERIFY_TRACE": "0",
    "GPU_PINNED_MIN_XFER_SIZE": "1048576",
    "STRATA_GDN_HEAD": "1",
    "STRATA_GDN_PP": "2",
    "STRATA_GDN_CONVL2": "1",
    "STRATA_GDN_NOY": "1",
    "STRATA_CVEC_FUSE": "1",
    "STRATA_ROUTE_RESIDENT": "1.0",
    "STRATA_PREFILL_CPU_SHARE": "auto",
    "STRATA_IO_PREFETCH": "1",
    "STRATA_IO_PF_AHEAD": "0",
    "STRATA_IO_PF_STAGE": "0"
  },
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "presence_penalty": 0.0
  }
}
