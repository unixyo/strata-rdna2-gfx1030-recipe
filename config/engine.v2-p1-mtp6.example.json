{
  "_comment": "Sanitized daily-use v2 P1_MTP6 example config (--vision ON, reserve 896 MiB, STRATA_IQ512_EXACT_GU=1) for RX 6900 XT (gfx1030) + 64 GB RAM + Zen 4 on Strata 2af30ccaa + patches/v2/000[1-4]. Note: results/v2-phase1-2.md benchmark tables ran text-only (--vision OFF), reserve 512/768 MiB, and STRATA_IQ512_EXACT_GU OFF. Replace every <...> placeholder.",
  "exe": "<build-dir>/strata",
  "backend": "hip",
  "port": 18090,
  "cwd": "<strata-source-tree>/terminal",
  "args": [
    "--pack", "<models>/SC117-IQ3_XXS/pack-strata-v0142",
    "--native", "<models>/SC117-IQ3_XXS/IQ3_XXS/<model-shard-1>.gguf",
    "--native-dense-gguf", "<models>/SC117-IQ3_XXS/IQ3_XXS/<model-shard-1>.gguf",
    "--native-dense-gguf", "<models>/SC117-IQ3_XXS/IQ3_XXS/<model-shard-2>.gguf",
    "--ple-gguf", "<models>/<PLE-IQ4_NL-table>.gguf",
    "--expert-profile", "<data>/expert-profile.bin",
    "--mtp", "<models>/<mtp-runtime-dir>",
    "--mtp-draft-vocab", "<draft-vocab-ko>.bin",
    "--expert-cache", "auto",
    "--vram-reserve-mib", "896",
    "--mmap-experts",
    "--prefill", "auto:11776",
    "--max-context", "262144",
    "--kv", "k8v4",
    "--kv-grow",
    "--spec", "6",
    "--spec-min-p", "0.5",
    "--mtp-window", "8192",
    "--adapt-every", "1",
    "--adapt-decay", "0.97",
    "--adapt-swaps", "80",
    "--short-read", "64",
    "--vision"
  ],
  "env": {
    "LD_LIBRARY_PATH": "<rocm10-gfx103X>/install/lib",
    "STRATA_ROCBLAS_TUNING": "<strata-source-tree>/terminal/tools/hip",
    "STRATA_SELECT_SIMT": "1",
    "STRATA_IQ_MT_MIN": "1",
    "STRATA_IQ512_EXACT_GU": "1",
    "STRATA_VERIFY_COHERENT": "1",
    "STRATA_VERIFY_TRACE": "0",
    "GPU_PINNED_MIN_XFER_SIZE": "1048576",
    "STRATA_GDN_HEAD": "1",
    "STRATA_GDN_PP": "2",
    "STRATA_GDN_CONVL2": "1",
    "STRATA_GDN_NOY": "1",
    "STRATA_CVEC_FUSE": "1",
    "STRATA_PREFILL_CPU_SHARE": "auto",
    "STRATA_PREFILL_HOST_PLAN": "0",
    "STRATA_IO_PREFETCH": "1",
    "STRATA_IO_PF_AHEAD": "0",
    "STRATA_IO_PF_STAGE": "0",
    "STRATA_EXP_MODE": "9",
    "STRATA_RDNA2_HEAD": "1",
    "STRATA_SKIP_ZERO_PCIE": "1",
    "STRATA_HC_REQ8": "1",
    "STRATA_GR_RDNA": "1",
    "STRATA_ROUTE_RESIDENT": "0",
    "STRATA_ROUTE_SMART": "0.15,3.0,2,1",
    "STRATA_PF_DIRECT_HYBRID": "1",
    "STRATA_LM_I8": "1",
    "STRATA_I8_DEFER": "1",
    "STRATA_MTP_ADAPT": "6,0.40,0.15,1.35,0.55"
  },
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "presence_penalty": 0.0
  }
}
