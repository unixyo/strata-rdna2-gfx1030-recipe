+// STRATA_ROUTE_SMART="budget[,max_gap[,core_k[,win_share[,decode_only]]]]" (opt-in, default OFF):
+// perturbation-budgeted, window-coherent MoE routing.
+struct RouteSmartCfg;
+RouteSmartCfg& route_smart_cfg();
+struct RouteSmartCfg {
+    strata::kernels::RouteSmartParams p;
+    std::mutex mu;
+    std::map<int, unsigned long long*> blocks;
+    unsigned long long* stats_on(int dev) {
+        if (p.budget <= 0.0f || dev < 0) return nullptr;
+        std::lock_guard<std::mutex> lk(mu);
+        const auto it = blocks.find(dev);
+        if (it != blocks.end()) return it->second;
+        unsigned long long* ptr = nullptr;
+        {
+            const OnDevice on(dev);
+            if (cudaMalloc((void**) &ptr, 10 * sizeof(unsigned long long)) != cudaSuccess ||
+                cudaMemset(ptr, 0, 10 * sizeof(unsigned long long)) != cudaSuccess) {
+                (void) cudaGetLastError();
+                if (ptr != nullptr) cudaFree(ptr);
+                ptr = nullptr;
+            }
+        }
+        if (blocks.empty()) {
+            std::atexit([] {
+                RouteSmartCfg& c = route_smart_cfg();
+                for (const auto& kv : c.blocks) {
+                    if (kv.second == nullptr) continue;
+                    unsigned long long h[10] = {};
+                    if (cudaSetDevice(kv.first) != cudaSuccess || cudaDeviceSynchronize() != cudaSuccess ||
+                        cudaMemcpy(h, kv.second, sizeof(h), cudaMemcpyDeviceToHost) != cudaSuccess) {
+                        (void) cudaGetLastError();
+                        continue;
+                    }
+                    const double mean_pert = h[1] ? (double) h[8] / (1e6 * (double) h[1]) : 0.0;
+                    const double orig_c = h[0] ? (double) h[6] / (double) h[0] : 0.0;
+                    const double fin_c = h[0] ? (double) h[7] / (double) h[0] : 0.0;
+                    std::fprintf(stderr,
+                                 "route-smart: budget=%g max_gap=%g core_k=%d win_share=%d decode_only=%d | "
+                                 "wins=%llu toks=%llu mod=%llu | misses %llu->%llu (vram_sw=%llu win_sw=%llu) | "
+                                 "distinct_cold/win %.2f->%.2f (%.1f%%) | mean_pert=%.4f\n",
+                                 c.p.budget, c.p.max_gap, c.p.core_k, c.p.win_share, c.p.decode_only,
+                                 h[0], h[1], h[9], h[2], h[3], h[4], h[5],
+                                 orig_c, fin_c, h[6] ? 100.0 * (1.0 - (double) h[7] / (double) h[6]) : 0.0, mean_pert);
+                }
+            });
+        }
+        blocks[dev] = ptr;
+        return ptr;
+    }
+};
+RouteSmartCfg& route_smart_cfg() {
+    static RouteSmartCfg c;
+    static const bool parsed = [] {
+        if (const char* v = std::getenv("STRATA_ROUTE_SMART")) {
+            float b = 0.0f, mg = 3.0f;
+            int ck = 2, ws = 1, dec = 1;
+            const int n = std::sscanf(v, "%f,%f,%d,%d,%d", &b, &mg, &ck, &ws, &dec);
+            if (n >= 1 && b > 0.0f) {
+                c.p.budget = b;
+                c.p.max_gap = mg;
+                c.p.core_k = ck;
+                c.p.win_share = ws;
+                c.p.decode_only = dec;
+            }
+        }
+        return true;
+    }();
+    (void) parsed;
+    return c;
+}
