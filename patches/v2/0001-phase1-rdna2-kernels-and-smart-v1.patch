+bool WeightTable::load_hc_q4(const std::string& pack_dir, int mode, uint64_t& bytes, std::string& err) {
+    // STRATA_HC_REQ4=1: all 4 HC projections (attn/ffn down & up) as IQ4_NL (4-bit nonlinear codebook + fp32/32 scale).
+    // STRATA_HC_REQ4=2: mixed precision (down = Q8, up = IQ4_NL) to preserve the 320-dim bottleneck while halving up.
+    static constexpr int8_t kIq4Lut[16] = {
+        -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113
+    };
+    auto nearest_iq4 = [](float v) -> uint8_t {
+        // Midpoints between consecutive sorted codebook entries in kIq4Lut[0..15].
+        static constexpr float kMid[15] = {
+            -115.5f, -93.5f, -74.0f, -57.0f, -42.0f, -28.5f, -16.0f, -4.5f,
+            7.0f, 19.0f, 31.5f, 45.5f, 61.0f, 79.0f, 101.0f
+        };
+        int lo = 0, hi = 15;
+        while (lo < hi) {
+            const int mid = (lo + hi) >> 1;
+            if (v > kMid[mid]) lo = mid + 1;
+            else hi = mid;
+        }
+        return (uint8_t) lo;
+    };
+
+    bytes = 0;
+    struct Item {
+        WeightRef* w;
+        bool use_q4;
+    };
+    std::vector<Item> todo;
+    for (auto& [name, w] : table_) {
+        const bool is_down = name.find(".hc_attn_down.") != std::string::npos || name.find(".hc_ffn_down.") != std::string::npos;
+        const bool is_up = name.find(".hc_attn_up.") != std::string::npos || name.find(".hc_ffn_up.") != std::string::npos;
+        if ((!is_down && !is_up) || w.resident) continue;
+        if (w.kind != WeightKind::Bf16InF32 || w.ne0 % 32 != 0 ||
+            (w.src_bytes != (uint64_t) w.elements * 4 && w.src_bytes != (uint64_t) w.elements * 2)) {
+            err = "STRATA_HC_REQ4: " + name + " is not a BF16 tensor of whole 32-value blocks";
+            return false;
+        }
+        const bool use_q4 = (mode == 1) || (mode == 2 && is_up);
+        todo.push_back({&w, use_q4});
+    }
+    if (todo.empty()) return true;
+    auto al = [](uint64_t b) { return (b + 255) & ~(uint64_t) 255; };
+    uint64_t total = 0;
+    for (const auto& it : todo) {
+        const uint64_t cbytes = it.use_q4 ? ((uint64_t) it.w->elements / 2) : (uint64_t) it.w->elements;
+        total += al(cbytes) + al((uint64_t) it.w->elements / 32 * 4);
+    }
+    uint8_t* dev = nullptr;
+    if (cudaMalloc((void**) &dev, total) != cudaSuccess) { err = "STRATA_HC_REQ4: cudaMalloc failed"; return false; }
+
+    std::vector<float> src;
+    std::vector<uint8_t> codes_host;
+    std::vector<float> sc;
+    uint64_t at = 0;
+    for (const auto& it : todo) {
+        WeightRef* w = it.w;
