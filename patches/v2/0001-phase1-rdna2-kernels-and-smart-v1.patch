index 000000000..3276c67fd
--- /dev/null
+++ b/engine/include/strata/kernels/route_smart.hpp
@@ -0,0 +1,32 @@
+// include/strata/kernels/route_smart.hpp - STRATA_ROUTE_SMART: perturbation-budgeted, window-coherent MoE routing
+// (opt-in, default OFF, changes the output).
+//
+// Operates cooperatively across all T tokens of a verify window in one thread block:
+//   Phase 1: Protect top `core_k` ranks of every token and register their mandatory cold misses in `s_win`.
+//   Phase 2: Register non-core cold misses that cannot be replaced by any VRAM expert within (budget, max_gap).
+//   Phase 3: Greedily replace remaining non-VRAM, non-`s_win` cold misses in ascending order of weighted logit
+//            perturbation w[r] * (logit[e] - logit[f]) against P = VRAM U (win_share ? s_win : empty),
+//            subject to per-token cumulative perturbation <= budget and per-swap gap <= max_gap, then
+//            renormalize router softmax weights over the final 10 experts.
+#pragma once
+
+#include <cstdint>
+
+namespace strata::kernels {
+
+struct RouteSmartParams {
+    float budget = 0.0f;      ///< cumulative per-token weighted perturbation budget sum(w[r]*(l[e]-l[f]))
+    float max_gap = 3.0f;     ///< hard cap on individual logit gap (l[e] - l[f])
+    int core_k = 2;           ///< top ranks [0..core_k-1] are strictly protected (never swapped)
+    int win_share = 1;        ///< 1: allow zero-extra-cost reuse of mandatory cold misses in the same window
+    int decode_only = 1;      ///< 1: apply only to decode windows (n_tok <= 8); 0: also prompt chunks
+};
+
+// stats layout (10 x uint64_t on device, optional nullptr):
+//   [0] total_windows, [1] total_tokens, [2] orig_miss_entries, [3] final_miss_entries,
+//   [4] swapped_vram, [5] swapped_win_share, [6] distinct_cold_before, [7] distinct_cold_after,
+//   [8] sum_pert_x1e6 (fixed-point 1e-6), [9] tokens_modified
+void route_smart_top10(const float* logits, const int32_t* res_layer, int32_t* ids, float* weights,
+                       int n_tok, const RouteSmartParams& params, unsigned long long* stats, void* stream);
+
+}  // namespace strata::kernels
