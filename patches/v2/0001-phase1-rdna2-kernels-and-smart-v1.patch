diff --git a/engine/src/kernels/cuda/route_smart.cu b/engine/src/kernels/cuda/route_smart.cu
new file mode 100644
index 000000000..ab7a6f6fe
--- /dev/null
+++ b/engine/src/kernels/cuda/route_smart.cu
@@ -0,0 +1,300 @@
+// src/kernels/cuda/route_smart.cu - STRATA_ROUTE_SMART: perturbation-budgeted, window-coherent MoE routing.
+#include "strata/kernels/route_smart.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cfloat>
+#include <cmath>
+
+namespace strata::kernels {
+namespace {
+
+constexpr int kE = 512;
+constexpr int kK = 10;
+constexpr int kMaxChunkT = 16;
+
+__device__ __forceinline__ bool bit_test(const uint32_t* bits, int e) {
+    return ((bits[e >> 5] >> (e & 31)) & 1u) != 0u;
+}
+
+__device__ __forceinline__ void bit_set_atomic(uint32_t* bits, int e) {
+    atomicOr(&bits[e >> 5], 1u << (e & 31));
+}
+
+__device__ __forceinline__ void warp_argmax(float& score, int& eid, float& raw_l) {
+#pragma unroll
+    for (int m = 16; m > 0; m >>= 1) {
+        const float os = __shfl_xor_sync(0xffffffffu, score, m, 32);
+        const int oe = __shfl_xor_sync(0xffffffffu, eid, m, 32);
+        const float ol = __shfl_xor_sync(0xffffffffu, raw_l, m, 32);
+        if (os > score || (os == score && oe < eid)) {
+            score = os;
+            eid = oe;
+            raw_l = ol;
+        }
+    }
+}
+
+// One block of n_tok warps (up to kMaxChunkT = 16 warps = 512 threads).
+// Each warp owns one token `t`; each lane owns 16 experts: e = lane + 32 * i.
+__global__ void route_smart_k(const float* __restrict__ logits, const int32_t* __restrict__ res,
+                              int32_t* __restrict__ ids, float* __restrict__ weights, int n_tok,
+                              float budget, float max_gap, int core_k, int win_share,
+                              unsigned long long* __restrict__ stats) {
+    __shared__ uint32_t s_win[16];
+    __shared__ uint32_t s_orig_cold[16];
+    __shared__ uint32_t s_final_cold[16];
+
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+    if (warp == 0 && lane < 16) {
+        s_win[lane] = 0u;
+        s_orig_cold[lane] = 0u;
+        s_final_cold[lane] = 0u;
+    }
+    __syncthreads();
+    if (warp >= n_tok) return;
+
+    const float* lg = logits + (size_t) warp * kE;
+    int32_t* id_out = ids + (size_t) warp * kK;
+    float* w_out = weights + (size_t) warp * kK;
+
+    float lval[16];
+    uint16_t res_mask = 0u;     // bit i: expert (lane + 32*i) is in VRAM
+    uint16_t picked_mask = 0u;  // bit i: expert (lane + 32*i) is currently in this token's top-10
+    float lmax = -FLT_MAX;
+    bool valid_logits = true;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) {
+        const int e = lane + 32 * i;
+        const float v = lg[e];
+        lval[i] = v;
+        if (!isfinite(v)) valid_logits = false;
+        if (v > lmax) lmax = v;
+        if (res[e] >= 0) res_mask |= (uint16_t) (1u << i);
+    }
+#pragma unroll
+    for (int m = 16; m > 0; m >>= 1) {
+        lmax = fmaxf(lmax, __shfl_xor_sync(0xffffffffu, lmax, m, 32));
+        valid_logits = valid_logits && (__shfl_xor_sync(0xffffffffu, valid_logits ? 1 : 0, m, 32) != 0);
+    }
+
+    int cur_id[kK];
+    float cur_w[kK];
+    float cur_l[kK];
+    uint8_t cur_res[kK];
+    int orig_misses = 0;
+    bool valid_ids = valid_logits;
+#pragma unroll
+    for (int r = 0; r < kK; ++r) {
+        const int e = id_out[r];
+        const float w = w_out[r];
+        cur_id[r] = e;
+        cur_w[r] = w;
+        if (e < 0 || e >= kE || !isfinite(w) || w < 0.0f) {
+            valid_ids = false;
+            cur_l[r] = -FLT_MAX;
+            cur_res[r] = 1;
+        } else {
+            cur_l[r] = lg[e];
+            cur_res[r] = (res[e] >= 0) ? 1 : 0;
+            if ((e & 31) == lane) picked_mask |= (uint16_t) (1u << (e >> 5));
+            if (!cur_res[r]) {
+                ++orig_misses;
+                if (lane == 0) bit_set_atomic(s_orig_cold, e);
+            }
+        }
+    }
+
+    // Phase 1: Protect top core_k ranks; any cold expert among them MUST run on CPU -> register in s_win.
+    if (valid_ids && lane == 0) {
+        const int ck = core_k < 0 ? 0 : (core_k > kK ? kK : core_k);
+        for (int r = 0; r < ck; ++r) {
+            if (!cur_res[r]) bit_set_atomic(s_win, cur_id[r]);
+        }
+    }
+    __syncthreads();
+
+    // Phase 2: Find best unpicked VRAM logit for this token; any non-core cold expert whose minimum possible
+    // VRAM-swap cost already exceeds (max_gap, budget) is very likely to stay cold -> pre-register in s_win
+    // so sibling tokens in the same window can reuse it at zero extra CPU/SSD bandwidth.
+    if (valid_ids && win_share != 0) {
+        float best_vram_l = -FLT_MAX;
+#pragma unroll
+        for (int i = 0; i < 16; ++i) {
+            if ((res_mask & (1u << i)) != 0u && (picked_mask & (1u << i)) == 0u) {
+                if (lval[i] > best_vram_l) best_vram_l = lval[i];
+            }
+        }
+#pragma unroll
+        for (int m = 16; m > 0; m >>= 1) {
+            best_vram_l = fmaxf(best_vram_l, __shfl_xor_sync(0xffffffffu, best_vram_l, m, 32));
+        }
+        if (lane == 0) {
+            const int ck = core_k < 0 ? 0 : (core_k > kK ? kK : core_k);
+            for (int r = ck; r < kK; ++r) {
+                if (!cur_res[r] && !bit_test(s_win, cur_id[r])) {
+                    const float gap = cur_l[r] - best_vram_l;
+                    const float cost = gap > 0.0f ? cur_w[r] * gap : 0.0f;
+                    if (gap > max_gap || cost > budget) {
+                        bit_set_atomic(s_win, cur_id[r]);
+                    }
+                }
+            }
+        }
+    }
+    __syncthreads();
+
+    // Phase 3: Greedy minimum-perturbation replacement over r in [core_k, 10) for experts not in VRAM
+    // and (if win_share) not already in s_win.
+    int swapped_vram = 0;
+    int swapped_win = 0;
+    float spent_pert = 0.0f;
+    bool modified = false;
+
+    if (valid_ids) {
+        const int ck = core_k < 0 ? 0 : (core_k > kK ? kK : core_k);
+        float rem_budget = budget;
+        uint16_t win_mask = 0u;
+        if (win_share != 0) {
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                const int e = lane + 32 * i;
+                if (bit_test(s_win, e)) win_mask |= (uint16_t) (1u << i);
+            }
+        }
+        const uint16_t cand_pool = res_mask | win_mask;
+        uint8_t eligible[kK];
+        for (int r = 0; r < kK; ++r) {
+            if (r < ck || cur_res[r] || (win_share != 0 && bit_test(s_win, cur_id[r]))) {
+                eligible[r] = 0;
+            } else {
+                eligible[r] = 1;
+            }
+        }
+
+        // At most (10 - ck) greedy swaps.
+        for (int step = 0; step < kK; ++step) {
+            // Find the single best unpicked candidate in cand_pool (small +0.05 bias prefers VRAM over s_win on near-ties
+            // so we avoid even CPU compute when a VRAM resident expert is essentially equal).
+            float best_sc = -FLT_MAX;
+            float best_raw = -FLT_MAX;
+            int best_f = kE;
+            const uint16_t avail = cand_pool & (uint16_t) (~picked_mask);
+#pragma unroll
+            for (int i = 0; i < 16; ++i) {
+                if ((avail & (1u << i)) != 0u) {
+                    const float rl = lval[i];
+                    const float sc = rl + ((res_mask & (1u << i)) != 0u ? 0.05f : 0.0f);
+                    if (sc > best_sc) {
+                        best_sc = sc;
+                        best_raw = rl;
+                        best_f = lane + 32 * i;
+                    }
+                }
+            }
+            warp_argmax(best_sc, best_f, best_raw);
+            if (best_f >= kE) break;
+
+            // Among currently eligible cold slots, pick the one with minimum perturbation cost w[r] * max(0, l[e] - best_raw).
+            int best_r = -1;
+            float best_cost = FLT_MAX;
+            for (int r = ck; r < kK; ++r) {
+                if (!eligible[r]) continue;
+                const float gap = cur_l[r] - best_raw;
+                if (gap > max_gap) continue;
+                const float cost = gap > 0.0f ? cur_w[r] * gap : 0.0f;
+                if (cost <= rem_budget && (cost < best_cost || (cost == best_cost && r > best_r))) {
+                    best_cost = cost;
+                    best_r = r;
+                }
+            }
+            if (best_r < 0) break;
+
+            // Commit swap in local state (same across all 32 lanes of this warp).
+            const int old_e = cur_id[best_r];
+            if ((old_e & 31) == lane) picked_mask &= (uint16_t) (~(1u << (old_e >> 5)));
+            if ((best_f & 31) == lane) picked_mask |= (uint16_t) (1u << (best_f >> 5));
+            cur_id[best_r] = best_f;
+            cur_l[best_r] = best_raw;
+            const bool f_in_vram = res[best_f] >= 0;
+            cur_res[best_r] = f_in_vram ? 1 : 0;
+            eligible[best_r] = 0;
+            rem_budget -= best_cost;
+            spent_pert += best_cost;
+            modified = true;
+            if (f_in_vram) ++swapped_vram;
+            else ++swapped_win;
+        }
+
+        // Write updated ids and exact softmax-renormalized router weights if anything changed.
+        if (modified) {
+            float p_sum = 0.0f;
+            float my_p = 0.0f;
+            int my_id = 0;
+            if (lane < kK) {
+                my_id = cur_id[lane];
+                my_p = expf(cur_l[lane] - lmax);
+            }
+            // Sum over lanes 0..9 across warp
+            p_sum = my_p;
+#pragma unroll
+            for (int m = 16; m > 0; m >>= 1) p_sum += __shfl_xor_sync(0xffffffffu, p_sum, m, 32);
+            if (lane < kK && isfinite(p_sum) && p_sum > 0.0f) {
+                id_out[lane] = my_id;
+                w_out[lane] = my_p / p_sum;
+            }
+        }
+    }
+
+    // Final cold-expert accounting.
+    int final_misses = 0;
+    if (lane == 0) {
+        for (int r = 0; r < kK; ++r) {
+            const int e = cur_id[r];
+            if (e >= 0 && e < kE && res[e] < 0) {
+                ++final_misses;
+                bit_set_atomic(s_final_cold, e);
+            }
+        }
+    }
+    __syncthreads();
+
+    if (stats != nullptr) {
+        if (lane == 0) {
+            atomicAdd(&stats[1], 1ULL);
+            atomicAdd(&stats[2], (unsigned long long) orig_misses);
+            atomicAdd(&stats[3], (unsigned long long) final_misses);
+            atomicAdd(&stats[4], (unsigned long long) swapped_vram);
+            atomicAdd(&stats[5], (unsigned long long) swapped_win);
+            if (modified) {
+                atomicAdd(&stats[8], (unsigned long long) (spent_pert * 1e6f + 0.5f));
+                atomicAdd(&stats[9], 1ULL);
+            }
+        }
+        if (warp == 0 && lane < 16) {
+            const int ob = __popc(s_orig_cold[lane]);
+            const int fb = __popc(s_final_cold[lane]);
+            if (ob > 0) atomicAdd(&stats[6], (unsigned long long) ob);
+            if (fb > 0) atomicAdd(&stats[7], (unsigned long long) fb);
+            if (lane == 0) atomicAdd(&stats[0], 1ULL);
+        }
+    }
+}
+
+}  // namespace
+
+void route_smart_top10(const float* logits, const int32_t* res_layer, int32_t* ids, float* weights,
+                       int n_tok, const RouteSmartParams& params, unsigned long long* stats, void* stream) {
+    if (n_tok <= 0 || params.budget <= 0.0f) return;
+    if (params.decode_only && n_tok > 8) return;
+    cudaStream_t st = (cudaStream_t) stream;
+    for (int off = 0; off < n_tok; off += kMaxChunkT) {
+        const int nt = (n_tok - off) < kMaxChunkT ? (n_tok - off) : kMaxChunkT;
+        route_smart_k<<<1, nt * 32, 0, st>>>(
+            logits + (size_t) off * kE, res_layer, ids + (size_t) off * kK, weights + (size_t) off * kK,
+            nt, params.budget, params.max_gap, params.core_k, params.win_share, stats);
+    }
+}
+
+}  // namespace strata::kernels
