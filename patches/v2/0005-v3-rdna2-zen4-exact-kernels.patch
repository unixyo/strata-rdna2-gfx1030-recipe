+// IQ4_NL's default rows already share one weight decode across tokens. Keep
+// that single-row layout, its block order and its horizontal reduction. On
+// Zen 4 the AVX2 TU cannot use VEX AVX-VNNI; EVEX VNNI is available here at
+// 256 bits, without the inserts/extracts of a 512-bit block-pair layout.
+namespace {
+template <int NT>
+void iq4nl_exact_down(const uint8_t* w, size_t rb, int n, const void* const* act,
+                      float* const* out, int r0, int r1) {
+    const __m256i lut = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) kvalues_iq4nl));
+    const __m256i nibble_shifts = _mm256_setr_epi16(0,0,0,0,0,0,0,0,4,4,4,4,4,4,4,4);
+    const __m256i mask4 = _mm256_set1_epi8(15);
+    const block_q8_0* y[NT];
+    for (int t = 0; t < NT; ++t) y[t] = (const block_q8_0*) act[t];
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* row = w + (size_t) r * rb;
+        __m256 acc[NT];
+        for (int t = 0; t < NT; ++t) acc[t] = _mm256_setzero_ps();
+        for (int ib = 0; ib < n / QK4_NL; ++ib) {
+            const uint8_t* b = row + (size_t) ib * sizeof(block_iq4_nl);
+            if (prefetch_ahead > 0) {
+                _mm_prefetch((const char*) b + prefetch_ahead, _MM_HINT_T0);
+                _mm_prefetch((const char*) b + prefetch_ahead + 64, _MM_HINT_T0);
+            }
+            const __m256i packed = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i*) (b + 2)));
+            const __m256i nib = _mm256_and_si256(_mm256_srlv_epi16(packed, nibble_shifts), mask4);
+            const __m256i q4 = _mm256_shuffle_epi8(lut, nib);
+            const __m256i aq = _mm256_abs_epi8(q4);
+            const float dx = h2f(u16(b));
+            for (int t = 0; t < NT; ++t) {
+                const block_q8_0& a = y[t][ib];
+                const __m256i q8 = _mm256_loadu_si256((const __m256i*) a.qs);
+                // The old maddubs cannot saturate: 2*127*128 = 32512.
+                // Preserve its sign semantics too (including int8 -128).
+                const __m256i p = _mm256_dpbusd_epi32(_mm256_setzero_si256(), aq, _mm256_sign_epi8(q8, q4));
+                acc[t] = _mm256_fmadd_ps(_mm256_set1_ps(dx * h2f(a.d)), _mm256_cvtepi32_ps(p), acc[t]);
+            }
+        }
+        for (int t = 0; t < NT; ++t) {
+            __m128 s = _mm_add_ps(_mm256_castps256_ps128(acc[t]), _mm256_extractf128_ps(acc[t], 1));
+            s = _mm_hadd_ps(s, s);
+            s = _mm_hadd_ps(s, s);
+            out[t][r] = _mm_cvtss_f32(s);
+        }
+    }
+}
+}  // namespace
+
+void iq512_exact_down_rows(int type, const uint8_t* w, size_t rb, int n,
+                           const void* const* act, int nt, float* const* out, int r0, int r1) {
+    if (type == 20) {
+        for (int t0 = 0; t0 < nt; t0 += 8) {
+            const int left = nt - t0, k = left < 8 ? left : 8;
+            switch (k) {
+                case 1: iq4nl_exact_down<1>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 2: iq4nl_exact_down<2>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 3: iq4nl_exact_down<3>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 4: iq4nl_exact_down<4>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 5: iq4nl_exact_down<5>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 6: iq4nl_exact_down<6>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 7: iq4nl_exact_down<7>(w, rb, n, act+t0, out+t0, r0, r1); break;
+                case 8: iq4nl_exact_down<8>(w, rb, n, act+t0, out+t0, r0, r1); break;
+            }
+        }
+    } else if (type == 18 || type == 21) {
+        // The decode-window form keeps signed-activation semantics and avoids
+        // allocating the prompt-sized temporary used by iq512x_rows at nt>6.
+        for (int t0 = 0; t0 < nt; t0 += 6) {
+            const int left = nt - t0, k = left < 6 ? left : 6;
+            iq512x_rows(type, w, rb, n, act+t0, k, out+t0, r0, r1);
+        }
+    }
+}
+
 }  // namespace strata::kernels::cpu
