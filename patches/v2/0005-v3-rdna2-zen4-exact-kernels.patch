+// CPU-only exact Down parity and interleaved DRAM-arena benchmark; no model or GPU.
+// --bench --workers 7 --experts 192 --rounds 5 [--type 20|18|21] [--nt N]
+#include "strata/kernels/cpu/expert_layout.hpp"
