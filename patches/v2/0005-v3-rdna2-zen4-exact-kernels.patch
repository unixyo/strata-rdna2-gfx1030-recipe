diff --git a/engine/tests/hip/v3_decode_dense_bench.cpp b/engine/tests/hip/v3_decode_dense_bench.cpp
new file mode 100644
index 000000000..94c1a5ccd
--- /dev/null
+++ b/engine/tests/hip/v3_decode_dense_bench.cpp
@@ -0,0 +1,135 @@
+// V3 synthetic dense decode profile. Adapted from sycl/src/kernels/dense_bench.cpp.
+// Distinct model-sized matrices live only in VRAM; the host holds one synthetic matrix.
+// No model, filesystem cache operation, or SSD input. Timings exclude quantization.
+#include <cuda_runtime.h>
+#include "strata/kernels/native_mmvq.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+namespace k = strata::kernels;
+namespace {
+void ck(cudaError_t e, const char* where) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", where, cudaGetErrorString(e)); std::exit(2); }
+}
+void fill(int t, std::vector<uint8_t>& w, std::mt19937& rng) {
+    for (auto& v : w) v = (uint8_t)rng();
+    const size_t bs = t == 14 ? 210 : t == 13 ? 176 : t == 12 ? 144 : t == 11 ? 110 :
+                      t == 23 ? 136 : t == 21 ? 110 : t == 42 ? 18 : 34;
+    const size_t off = t == 14 ? 208 : t == 11 ? 108 : 0;
+    for (size_t o = 0; o + bs <= w.size(); o += bs) {
+        const uint16_t h = (uint16_t)(0x1400 | (rng() & 0x3ff));
+        std::memcpy(w.data()+o+off, &h, 2);
+        if (t == 12 || t == 13) std::memcpy(w.data()+o+2, &h, 2);
+    }
+}
+uint64_t hash(const float* p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; ++i) {
+        if (!std::isfinite(p[i])) { std::fprintf(stderr,"nonfinite output at %zu\n",i); std::exit(3); }
+        uint32_t u; std::memcpy(&u,p+i,4); h=(h^u)*1099511628211ull;
+    }
+    return h;
+}
+}
+int main(int argc, char** argv) {
+    std::vector<int> types;
+    bool all_columns = false, selftest = false;
+    for (int i=1;i<argc;++i) {
+        if (std::strcmp(argv[i], "--all-columns") == 0) all_columns = true;
+        else if (std::strcmp(argv[i], "--selftest") == 0) selftest = all_columns = true;
+        else types.push_back(std::atoi(argv[i]));
+    }
+    const std::vector<int> columns = all_columns ? std::vector<int>{1,2,3,4,5,6,7,8} : std::vector<int>{1,4,6,8};
+    if (types.empty()) types={11,14,23,42,8};
+    for (int t:types) if (t!=11 && t!=12 && t!=13 && t!=14 && t!=21 && t!=23 && t!=42 && t!=8) return 2;
+    const int NMAT = selftest ? 3 : 24;
+    constexpr int MC=8;
+    int devices = 0;
+    if (cudaGetDeviceCount(&devices) != cudaSuccess || devices == 0) return 77;
+    cudaStream_t s; ck(cudaStreamCreateWithFlags(&s,cudaStreamNonBlocking),"stream");
+    k::native_mmvq_set_multi_exact(true);
+    std::mt19937 rng(7);
+    const struct Shape { int ni,no,uses; const char* name; } shapes[]={
+        {2560,10240,36,"gdn_qkv"},{2560,6144,36,"gdn_z"},{6144,2560,48,"gdn_qsa_out"},
+        {2560,12288,12,"qsa_q"},{2560,512,24,"qsa_kv"}};
+    std::printf("V3 dense decode: synthetic type scenarios, not current model type inventory; %d distinct VRAM matrices/shape, graph timing median20\n",NMAT);
+    for (int ty:types) {
+        std::vector<double> total(columns.size(), 0.0);
+        for (auto sh:shapes) {
+            size_t wb=k::native_mmvq_weight_bytes(ty,sh.ni,sh.no), slot=(wb+255)&~size_t(255);
+            uint8_t* w; ck(cudaMalloc((void**)&w,slot*NMAT),"weights");
+            std::vector<uint8_t> hw(wb);
+            for (int m=0;m<NMAT;++m) { fill(ty,hw,rng); ck(cudaMemcpy(w+slot*m,hw.data(),wb,cudaMemcpyHostToDevice),"weights upload"); }
+            std::vector<float> hx((size_t)MC*sh.ni);
+            std::normal_distribution<float> nd(0,1);
+            for (auto& v:hx) v=nd(rng);
+            float *x,*y,*ref; void* xq;
+            ck(cudaMalloc((void**)&x,hx.size()*4),"x");
+            ck(cudaMalloc(&xq,k::native_q8_1_bytes(sh.ni,MC)),"xq");
+            ck(cudaMalloc((void**)&y,(size_t)(MC*sh.no+16)*NMAT*4),"y");
+            ck(cudaMemcpy(x,hx.data(),hx.size()*4,cudaMemcpyHostToDevice),"x upload");
+            // Independent existing one-column dispatch is the exact-layout oracle.
+            ck(cudaMalloc((void**)&ref,(size_t)MC*sh.no*NMAT*4),"reference");
+            k::native_quantize_q8_1(x,xq,sh.ni,MC,s);
+            const size_t qstride=k::native_q8_1_bytes(sh.ni,1);
+            for(int m=0;m<NMAT;++m) for(int c=0;c<MC;++c)
+                k::native_mmvq(ty,w+slot*m,(const uint8_t*)xq+qstride*c,
+                              ref+((size_t)m*MC+c)*sh.no,sh.ni,sh.no,1,s);
+            ck(cudaStreamSynchronize(s),"reference sync");
+            std::vector<float> href((size_t)MC*sh.no*NMAT);
+            ck(cudaMemcpy(href.data(),ref,href.size()*4,cudaMemcpyDeviceToHost),"reference download");
+            int ci=0;
+            for(int nc:columns) {
+                k::native_quantize_q8_1(x,xq,sh.ni,nc,s);
+                ck(cudaMemsetAsync(y,0x42,(size_t)(MC*sh.no+16)*NMAT*4,s),"sentinel");
+                // Resolve host-side cached dispatch before capture.
+                k::native_mmvq(ty,w,xq,y,sh.ni,sh.no,nc,s);
+                ck(cudaStreamSynchronize(s),"warm dispatch");
+                cudaGraph_t g; cudaGraphExec_t ge;
+                ck(cudaStreamBeginCapture(s,cudaStreamCaptureModeThreadLocal),"capture");
+                for(int m=0;m<NMAT;++m)
+                    k::native_mmvq(ty,w+slot*m,xq,y+(size_t)(MC*sh.no+16)*m,sh.ni,sh.no,nc,s);
+                ck(cudaStreamEndCapture(s,&g),"end capture");
+                ck(cudaGraphInstantiate(&ge,g,nullptr,nullptr,0),"instantiate");
+                cudaEvent_t a,b; ck(cudaEventCreate(&a),"event"); ck(cudaEventCreate(&b),"event");
+                std::vector<float> us;
+                for(int it=0;it<(selftest ? 1 : 25);++it) {
+                    ck(cudaEventRecord(a,s),"record"); ck(cudaGraphLaunch(ge,s),"graph"); ck(cudaEventRecord(b,s),"record");
+                    ck(cudaEventSynchronize(b),"sync"); float ms; ck(cudaEventElapsedTime(&ms,a,b),"elapsed");
+                    if(selftest || it>=5) us.push_back(ms*1000/NMAT);
+                }
+                std::sort(us.begin(),us.end());
+                std::vector<float> hy((size_t)(MC*sh.no+16)*NMAT);
+                ck(cudaMemcpy(hy.data(),y,hy.size()*4,cudaMemcpyDeviceToHost),"download");
+                uint64_t h=0;
+                for(int m=0;m<NMAT;++m) {
+                    const size_t off=(size_t)(MC*sh.no+16)*m;
+                    h^=hash(hy.data()+off,(size_t)nc*sh.no)+m;
+                    if(std::memcmp(hy.data()+off,href.data()+(size_t)m*MC*sh.no,(size_t)nc*sh.no*4)!=0) {
+                        std::fprintf(stderr,"one-column parity failed type=%d K=%d N=%d T=%d matrix=%d\n",ty,sh.ni,sh.no,nc,m);
+                        return 4;
+                    }
+                    for(int j=nc*sh.no;j<MC*sh.no+16;++j) {
+                        uint32_t u; std::memcpy(&u,hy.data()+off+j,4);
+                        if(u!=0x42424242u) { std::fprintf(stderr,"write canary changed\n"); return 3; }
+                    }
+                }
+                double med=us[us.size()/2]; total[ci++]+=med*sh.uses/1000;
+                std::printf("DENSE_DECODE type=%d shape=%s T=%d K=%d N=%d uses=%d median_us=%.4f min_us=%.4f max_us=%.4f weight_GBs=%.2f hash=%016llx\n",
+                    ty,sh.name,nc,sh.ni,sh.no,sh.uses,med,us.front(),us.back(),wb/med/1000,(unsigned long long)h);
+                std::fflush(stdout);
+                ck(cudaEventDestroy(a),"destroy"); ck(cudaEventDestroy(b),"destroy");
+                ck(cudaGraphExecDestroy(ge),"destroy"); ck(cudaGraphDestroy(g),"destroy");
+            }
+            ck(cudaFree(w),"free"); ck(cudaFree(x),"free"); ck(cudaFree(xq),"free"); ck(cudaFree(y),"free"); ck(cudaFree(ref),"free");
+        }
+        int ci=0; for(int nc:columns) std::printf("DENSE_DECODE_TOTAL type=%d T=%d projection_only_ms=%.4f\n",ty,nc,total[ci++]);
+    }
+    ck(cudaStreamDestroy(s),"destroy stream");
+    std::printf("DENSE_DECODE: all one-column bit parity and inactive-tail canaries PASS\n"); return 0;
+}
