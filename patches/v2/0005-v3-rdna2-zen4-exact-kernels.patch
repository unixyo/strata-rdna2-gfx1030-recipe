+// Strata v3 gfx1030 exact GDN recurrence. Included in prefill/kernels.cu's HIP namespace.
+// Preserve the two-column kernel's FMA chains, four-group sums, and state/output bits.
+// Adjacent lanes own the four row groups of a column: fixed quad DPP broadcasts replace
+// ds_bpermute. GT only changes the shared input staging depth (4 or 8); tails are guarded.
+template<int G>
+__device__ __forceinline__ float gdn_rdna2_bcast(float v) {
+#if defined(__gfx1030__)
+    return __int_as_float(__builtin_amdgcn_mov_dpp(__float_as_int(v), G * 0x55, 0xf, 0xf, false));
+#else
+    return __shfl_sync(0xffffffffu, v, (threadIdx.x & 28) + G);
+#endif
+}
+template<int GT>
+__global__ void __launch_bounds__(QTH) gdn_rec_quad2c_dpp_kernel(float* __restrict__ state, const float* __restrict__ h,
+                                                             const float* __restrict__ gate, const float* __restrict__ beta,
+                                                             float* __restrict__ oc_out, int64_t T) {
+    __shared__ __align__(16) float sqk[2][GT][2][4 * QRS];
+    __shared__ float sgb[2][2][GT];
+    __shared__ float sv[2][GT][C2CB];
+    const int head = blockIdx.x / (S / C2CB), cb = blockIdx.x % (S / C2CB);
+    const int tid = threadIdx.x, lane = tid & 31, wave = tid >> 5;
+    const int g = lane & 3, cl0 = wave * 16 + (lane >> 2), cl1 = cl0 + 8;   // the lane's two columns in the block
+    const int col0 = cb * C2CB + cl0, col1 = cb * C2CB + cl1;
+    const int qh = head % HK;
+    float s0[32], s1[32];
+    {
+        const float* sb = state + (size_t) head * S;
+        const uint32_t voff = (uint32_t) ((g * 32) * HV * S);
+#pragma unroll
+        for (int r = 0; r < 32; ++r) { s0[r] = sb[(size_t) r * HV * S + voff + col0]; s1[r] = sb[(size_t) r * HV * S + voff + col1]; }
+    }
+    float4 pf[(GT * 2 * S / 4 / QTH)];
+    float pv[2][GT], pgb = 0.0f;
+    auto fetch = [&](int64_t c) {
+        const int64_t t0 = c * GT;
+#pragma unroll
+        for (int u = 0; u < (GT * 2 * S / 4 / QTH); ++u) {
+            const int i = tid + u * QTH;
+            const int tt = i / (2 * S / 4), rem = i % (2 * S / 4), part = rem / (S / 4), r4 = rem % (S / 4);
+            const int64_t t = t0 + tt;
+            pf[u] = t < T ? *reinterpret_cast<const float4*>(h + t * C + part * HK * S + qh * S + r4 * 4)
+                          : make_float4(0.f, 0.f, 0.f, 0.f);
+        }
+        if (g == 0) {
+#pragma unroll
+            for (int tt = 0; tt < GT; ++tt) {
+                const int64_t t = t0 + tt;
+                pv[0][tt] = t < T ? h[t * C + 2 * HK * S + head * S + col0] : 0.0f;
+                pv[1][tt] = t < T ? h[t * C + 2 * HK * S + head * S + col1] : 0.0f;
+            }
+        }
+        if (tid < 2 * GT) {
+            const int64_t t = t0 + (tid % GT);
+            pgb = t < T ? (tid < GT ? gate : beta)[t * HV + head] : 0.0f;
+        }
+    };
