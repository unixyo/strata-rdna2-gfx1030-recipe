+
+namespace cpu = strata::kernels::cpu;
+namespace pq = cpu::pq;
+namespace {
+constexpr int width = 13;
+constexpr float sentinel = -12345.0f;
+using Clock = std::chrono::steady_clock;
+
+struct Fixture {
+    cpu::NativeFmt fmt;
+    std::vector<uint8_t> storage;
+    std::array<std::vector<uint8_t>, width> hq;
+    std::array<std::vector<float>, width> ref, opt, dispatch;
+    const void* hp[width];
+    float *rp[width], *op[width], *dp[width];
+    uint8_t* blob() { return storage.data() + 1; } // deliberately unaligned
+    const uint8_t* blob() const { return storage.data() + 1; }
+    const uint8_t* weights() { return blob() + fmt.down_off; }
+
+    bool init(int type, int n, int rows, std::mt19937& rng) {
+        std::string err;
+        if (!cpu::native_fmt(18, type, rows, n, fmt, err)) {
+            std::fprintf(stderr, "%s\n", err.c_str()); return false;
+        }
+        storage.assign(fmt.bytes + 2, 0);
+        const size_t bb = pq::type_size_of(type);
+        const uint16_t scales[] = {0,1,0x9400,0x2400,0x3000,0x3800};
+        for (size_t i = fmt.down_off; i < fmt.bytes; ++i) blob()[i] = (uint8_t) rng();
+        for (size_t i = fmt.down_off; i < fmt.bytes; i += bb) {
+            const uint16_t d = scales[rng() % 6];
+            std::memcpy(blob() + i, &d, 2);
+        }
+        for (int t = 0; t < width; ++t) {
+            hq[t].resize(fmt.h_bytes);
+            ref[t].resize(rows + 16); opt[t].resize(rows + 16); dispatch[t].resize(rows + 16);
+            hp[t] = hq[t].data();
+            rp[t] = ref[t].data()+8; op[t] = opt[t].data()+8; dp[t] = dispatch[t].data()+8;
+        }
+        return true;
+    }
+    void activations(std::mt19937& rng, float amp) {
+        std::vector<float> x(fmt.n_ff);
+        for (int t = 0; t < width; ++t) {
+            for (auto& v : x) v = (int(rng() % 2049) - 1024) * amp / 1024.f;
+            cpu::native_quant_h(fmt, x.data(), hq[t].data());
+        }
+    }
+    void raw_activations(std::mt19937& rng) {
+        // Preserve finite scales; test byte extremes, including -128. Q8_K
+        // bsums do not enter these IQ3 dots.
+        const size_t bb = pq::type_size_of(fmt.d_act);
+        const int count = pq::blck_size_of(fmt.d_act), off = fmt.d_act == 8 ? 2 : 4;
+        for (int t = 0; t < width; ++t)
+            for (size_t b = 0; b < fmt.h_bytes; b += bb)
+                for (int j = 0; j < count; ++j) hq[t][b+off+j] = (uint8_t) rng();
+    }
+    void baseline(const uint8_t* w, int nt, float* const* out, int r0, int r1) const {
+        if (fmt.d_type == 20) {
+            for (int t0 = 0; t0 < nt; t0 += 8)
+                cpu::iq4nl256_down_rows(w, fmt.d_row, (int) fmt.n_ff, hp+t0,
+                                        std::min(8,nt-t0), out+t0, r0, r1);
+        } else {
+            const auto dot = pq::traits(fmt.d_type);
+            for (int r = r0; r < r1; ++r)
+                for (int t = 0; t < nt; ++t)
+                    dot.dot((int) fmt.n_ff, &out[t][r], w+(size_t)r*fmt.d_row, hp[t]);
+        }
+    }
+    void candidate(const uint8_t* w, int nt, float* const* out, int r0, int r1) const {
+        cpu::iq512_exact_down_rows(fmt.d_type, w, fmt.d_row, (int)fmt.n_ff, hp, nt, out, r0, r1);
+    }
+};
+
+bool parity(std::mt19937& rng) {
+    size_t values = 0;
+    for (int type : {20,18,21}) {
+        const std::vector<int> ns = type == 20 ? std::vector<int>{32,64,96,256,640,768}
+                                             : std::vector<int>{256,512,768}; // pool Down buffers cap Q8_K at 768
+        for (int n : ns) {
+            Fixture f; if (!f.init(type,n,256,rng)) return false;
+            for (int mode = 0; mode < 5; ++mode) {
+                const float amps[] = {0,.01f,.3f,3.f,.3f};
+                f.activations(rng,amps[mode]);
+                if (mode == 4) f.raw_activations(rng);
+                for (int nt : {1,2,3,4,5,6,7,8,13}) {
+                    for (auto* vv : {&f.ref,&f.opt,&f.dispatch})
+                        for (auto& v : *vv) std::fill(v.begin(),v.end(),sentinel);
+                    f.baseline(f.weights(),nt,f.rp,0,256);
+                    f.candidate(f.weights(),nt,f.op,0,7);
+                    f.candidate(f.weights(),nt,f.op,7,131);
+                    f.candidate(f.weights(),nt,f.op,131,256);
+                    if (nt <= 8)
+                        cpu::native_down_rows(f.fmt,f.blob(),f.hp,nt,f.dp,0,256);
+                    for (int t = 0; t < width; ++t)
+                        for (int r = 0; r < 272; ++r) {
+                            const float a=f.ref[t][r], b=f.opt[t][r], c=f.dispatch[t][r];
+                            if (!std::isfinite(a) || std::memcmp(&a,&b,4) ||
+                                (nt <= 8 && std::memcmp(&a,&c,4))) {
+                                std::fprintf(stderr,"Down mismatch type=%d n=%d nt=%d mode=%d token=%d row=%d\n",type,n,nt,mode,t,r-8);
+                                return false;
+                            }
+                        }
+                    values += (size_t)nt*256;
+                }
+            }
+        }
+    }
+    std::printf("PASS: %zu Down values bit-identical; IQ4_NL/IQ3_XXS/IQ3_S, 1..8 and 13 tokens, odd blocks, unaligned weights, split rows and sentinels\n",values);
+    return true;
+}
+
+bool bench(std::mt19937& rng,int workers,int experts,int rounds,int only_type,int only_nt) {
+    std::printf("ISA avx512_vnni=%d vex_avxvnni=%d\n",cpu::cpu_vnni_ok(),cpu::cpu_avxvnni_ok());
+    std::puts("type,nt,workers,experts,round,baseline_ms,exact_ms");
+    for (int type : {20,18,21}) {
+        if (only_type && type != only_type) continue;
+        constexpr int rows = 2560;
+        // IQ4_NL is the actual Flash-Next Down shape; IQ3 needs whole 256-value blocks.
+        const int n = type == 20 ? 640 : 768;
+        Fixture f; if (!f.init(type,n,rows,rng)) return false;
+        f.activations(rng,.3f);
+        const size_t bytes=f.fmt.d_row*rows, stride=(bytes+4095)/4096*4096;
+        std::vector<uint8_t> arena(stride*experts);
+        for (int e=0;e<experts;++e) std::memcpy(arena.data()+stride*e,f.weights(),bytes);
+        std::vector<std::vector<float>> outs(workers,std::vector<float>(width*rows));
+        for (int nt : {1,2,3,4,6,8}) {
+            if (only_nt && nt != only_nt) continue;
+            auto run=[&](bool exact) {
+                std::atomic<int> next{0};
+                auto begin=Clock::now();
+                auto work=[&](int id) {
+                    float* out[width];
+                    for (int t=0;t<width;++t) out[t]=outs[id].data()+t*rows;
+                    for (int e;(e=next.fetch_add(1,std::memory_order_relaxed))<experts;)
+                        if (exact) f.candidate(arena.data()+stride*e,nt,out,0,rows);
+                        else f.baseline(arena.data()+stride*e,nt,out,0,rows);
+                };
+                if (workers==1) work(0);
+                else {
+                    std::vector<std::thread> ts;
+                    for(int t=0;t<workers;++t) ts.emplace_back(work,t);
+                    for(auto& t:ts) t.join();
+                }
+                return std::chrono::duration<double,std::milli>(Clock::now()-begin).count();
+            };
+            run(false);run(true);
+            for(int rd=0;rd<rounds;++rd) {
+                double a,b;
+                if(rd%2==0){a=run(false);b=run(true);}else{b=run(true);a=run(false);}
+                std::printf("%d,%d,%d,%d,%d,%.6f,%.6f\n",type,nt,workers,experts,rd,a,b);
+                std::fflush(stdout);
+            }
+        }
+    }
+    return true;
+}
+} // namespace
+
+int main(int argc,char** argv) {
+    if(!cpu::cpu_vnni_ok() || !cpu::iq512x_supported(18)) {
+        std::puts("SKIP: AVX-512 VNNI + VPOPCNTDQ required");return 77;
+    }
+    bool timing=false; int workers=7,experts=192,rounds=5,type=0,nt=0;
+    for(int i=1;i<argc;++i) {
+        if(!std::strcmp(argv[i],"--bench")) timing=true;
+        else if(i+1<argc && !std::strcmp(argv[i],"--workers")) workers=std::atoi(argv[++i]);
+        else if(i+1<argc && !std::strcmp(argv[i],"--experts")) experts=std::atoi(argv[++i]);
+        else if(i+1<argc && !std::strcmp(argv[i],"--rounds")) rounds=std::atoi(argv[++i]);
+        else if(i+1<argc && !std::strcmp(argv[i],"--type")) type=std::atoi(argv[++i]);
+        else if(i+1<argc && !std::strcmp(argv[i],"--nt")) nt=std::atoi(argv[++i]);
+        else return 2;
+    }
+    if(workers<1 || workers>16 || experts<1 || experts>256 || rounds<1 || rounds>20) return 2;
+    const char* mt=std::getenv("STRATA_IQ_MT_MIN");
+    if(!mt || std::strcmp(mt,"1")) {
+        std::fprintf(stderr,"Run with STRATA_IQ_MT_MIN=1 to compare the default grouped IQ4_NL contract at every width\n");
+        return 2;
+    }
+    std::mt19937 rng(20261127);
+    if(!parity(rng)) return 1;
+    if(timing && !bench(rng,workers,experts,rounds,type,nt)) return 1;
+    return 0;
+}
