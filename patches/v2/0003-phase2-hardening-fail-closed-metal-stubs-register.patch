 bool resident_sampled_n(const uint8_t* p, uint64_t n) { return resident_sampled(p, n) >= n; }
-/// The whole range with pread (a short read continues); false on an error or an end of file.
-bool pread_full(int fd, uint8_t* dst, uint64_t n, uint64_t off) {
+/// The whole range with pread (a short read continues); returns false and sets *err_out on error or unexpected EOF.
+bool pread_full_err(int fd, uint8_t* dst, uint64_t n, uint64_t off, int* err_out) {
     uint64_t done = 0;
     while (done < n) {
         const ssize_t r = ::pread(fd, dst + done, (size_t) (n - done), (off_t) (off + done));
-        if (r < 0) { if (errno == EINTR) continue; return false; }
-        if (r == 0) return false;
+        if (r < 0) {
+            if (errno == EINTR) continue;
+            if (err_out) *err_out = errno;
+            return false;
+        }
+        if (r == 0) {
+            if (err_out) *err_out = EIO;   // unexpected EOF inside valid file range
+            return false;
+        }
         done += (uint64_t) r;
     }
+    if (err_out) *err_out = 0;
     return true;
 }
+/// The whole range with pread (a short read continues); false on an error or an end of file.
+bool pread_full(int fd, uint8_t* dst, uint64_t n, uint64_t off) {
+    return pread_full_err(fd, dst, n, off, nullptr);
+}
 }  // namespace
