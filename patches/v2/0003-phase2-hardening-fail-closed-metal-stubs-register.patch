+// metal/src/engine/stubs_neon.cpp - Metal link stubs for the opt-in CUDA/HIP research kernels
+// (STRATA_ROUTE_SMART / STRATA_ROUTE_SMART_V2 in verify.cpp, STRATA_HC_REQ4 in prefill.cpp).
+// Both features are opt-in (default OFF); on Metal the default path never calls these symbols,
+// and enabling them explicitly fails cleanly with the entry-point name via strata::metal_engine::missing.
+
+#include <cstdint>
+
+#include "strata/kernels/fused_gr.hpp"
+#include "strata/kernels/route_smart.hpp"
+
+namespace strata::metal_engine { void missing(const char* name); }
+
+namespace strata::kernels {
+
+void route_smart_top10(const float*, const int32_t*, int32_t*, float*, int,
+                       const RouteSmartParams&, unsigned long long*, void*) {
+    strata::metal_engine::missing("strata::kernels::route_smart_top10");
+}
+
+void hc_iq4_to_bf16(const void*, const float*, uint16_t*, long long, void*) {
+    strata::metal_engine::missing("strata::kernels::hc_iq4_to_bf16");
+}
+
+}  // namespace strata::kernels
