+bool FileExpertSource::copy_blob_hybrid(int64_t layer, int64_t expert, uint8_t* dst) {
+    if (!hybrid_pf_ || !role_ptr_.empty() || unmapped_ || base_ == nullptr || dst == nullptr ||
+        layer < 0 || expert < 0 || layer >= n_layers_ || expert >= n_expert_) {
+        return copy_blob(layer, expert, dst);
+    }
+    const size_t index = (size_t) layer * (size_t) n_expert_ + (size_t) expert;
+    const uint64_t bytes = layer_blob_bytes_[(size_t) layer];
+    if (complement_ready_) {
+        const uint8_t* held = resident_blob(index);
+        if (held == nullptr && !override_.empty()) held = override_[index];
+        if (held != nullptr) {
+            std::memcpy(dst, held, (size_t) bytes);
+            hybrid_warm_blobs_.fetch_add(1, std::memory_order_relaxed);
+            return true;
+        }
+    }
+    const uint64_t off = layer_offsets_[(size_t) layer] + (uint64_t) expert * bytes;
+    if (off + bytes > mapped_bytes_) return false;
+#if defined(__linux__) && defined(O_DIRECT)
+    const uint8_t* mp = base_ + (size_t) off;
+    // Fast 4-page mincore residency probe: if warm in OS page cache, read from RAM at ~30 GB/s (0 SSD I/O).
+    if (resident_sampled(mp, bytes) >= bytes) {
+        std::memcpy(dst, mp, (size_t) bytes);
+        hybrid_warm_blobs_.fetch_add(1, std::memory_order_relaxed);
+        file_read_bytes_.fetch_add(bytes, std::memory_order_relaxed);
+        return true;
+    }
+    if (direct_prefill_fd_ >= 0) {
+        constexpr uint64_t kAlign = 4096ull;
+        const uint64_t a_off = off & ~(kAlign - 1ull);
+        const size_t head = (size_t) (off - a_off);
+        const uint64_t a_len = (uint64_t) ((head + bytes + kAlign - 1ull) & ~(kAlign - 1ull));
+        if (a_off + a_len <= mapped_bytes_) {
+            const auto t0 = std::chrono::steady_clock::now();
+            bool ok = false;
+            if (head == 0 && (bytes & (kAlign - 1ull)) == 0 && (((uintptr_t) dst) & (kAlign - 1ull)) == 0) {
+                ok = pread_full(direct_prefill_fd_, dst, bytes, off);
+            } else {
+                struct AlignedScratch {
+                    uint8_t* ptr = nullptr;
+                    size_t cap = 0;
+                    ~AlignedScratch() { if (ptr) std::free(ptr); }
+                    uint8_t* ensure(size_t need) {
+                        if (cap >= need) return ptr;
+                        if (ptr) { std::free(ptr); ptr = nullptr; cap = 0; }
+                        void* p = nullptr;
+                        if (posix_memalign(&p, 4096, need) != 0 || p == nullptr) return nullptr;
+                        ptr = (uint8_t*) p;
+                        cap = need;
+                        return ptr;
+                    }
+                };
+                thread_local AlignedScratch tls;
+                uint8_t* buf = tls.ensure((size_t) a_len);
+                if (buf != nullptr && pread_full(direct_prefill_fd_, buf, a_len, a_off)) {
+                    std::memcpy(dst, buf + head, (size_t) bytes);
+                    ok = true;
+                }
+            }
+            if (ok) {
+                file_us_.fetch_add((uint64_t) std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count(),
+                                   std::memory_order_relaxed);
+                file_read_bytes_.fetch_add(bytes, std::memory_order_relaxed);
+                hybrid_direct_blobs_.fetch_add(1, std::memory_order_relaxed);
+                hybrid_direct_bytes_.fetch_add(bytes, std::memory_order_relaxed);
+                return true;
+            }
+        }
+    }
+#endif
+    return copy_blob(layer, expert, dst);
+}
+
+bool FileExpertSource::scan_warm_bitmap(uint32_t* bits, int64_t n_layers, int64_t n_expert) const {
+    if (bits == nullptr || n_layers <= 0 || n_expert <= 0 || n_layers != n_layers_ || n_expert != n_expert_) return false;
+    const size_t n_words = (size_t) ((n_layers * n_expert + 31) / 32);
+    std::memset(bits, 0, n_words * sizeof(uint32_t));
+#if defined(__linux__)
+    if (base_ == nullptr || unmapped_ || !role_ptr_.empty()) return false;
+    constexpr uintptr_t kPg = 4096;
+    for (int64_t l = 0; l < n_layers_; ++l) {
+        const uint64_t bb = layer_blob_bytes_[(size_t) l];
+        if (bb == 0) continue;
+        const uint64_t loff = layer_offsets_[(size_t) l];
+        if (loff + bb * (uint64_t) n_expert_ > mapped_bytes_) continue;
+        for (int64_t e = 0; e < n_expert_; ++e) {
+            const size_t idx = (size_t) l * (size_t) n_expert_ + (size_t) e;
+            bool warm = false;
+            if (complement_ready_ && (resident_blob(idx) != nullptr || (!override_.empty() && override_[idx] != nullptr))) {
+                warm = true;
+            } else {
+                // Probe 1 middle page per expert (24,576 x 1-page mincore: ~5-10 ms total vs ~300 ms for 10.5M pages).
+                const uintptr_t mid = (uintptr_t) (base_ + (size_t) (loff + (uint64_t) e * bb + bb / 2));
+                unsigned char v = 0;
+                if (mincore((void*) (mid & ~(kPg - 1)), kPg, &v) == 0 && (v & 1)) warm = true;
+            }
+            if (warm) bits[idx >> 5] |= (1u << (idx & 31));
+        }
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
 // pp-opt: the prompt path streams a chunk's experts in file order, so a stager thread's run of jobs is mostly
 // neighbouring blobs of experts.bin.  One read_direct batch merges them into requests of up to 32 MiB (kMerge) where
 // copy_blob made one ~2 MB request each - and NTFS serves the unbuffered reads of a mapped file one at a time, so the
 // request size is what sets the rate (see read_direct).  The blobs the RAM copy holds are copied as before.
 bool FileExpertSource::copy_blobs(const int32_t* layers, const int32_t* experts, uint8_t* const* dst, size_t n) {
+    if (hybrid_pf_ && direct_.empty() && pdirect_.empty()) {
+        for (size_t i = 0; i < n; ++i)
+            if (!copy_blob_hybrid(layers[i], experts[i], dst[i])) return false;
+        return true;
+    }
     if ((direct_.empty() && pdirect_.empty()) || n <= 1) return ExpertSource::copy_blobs(layers, experts, dst, n);
     thread_local std::vector<Fill> fills;
     fills.clear();
