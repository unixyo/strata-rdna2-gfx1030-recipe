+bool Verifier::update_warm_bitmap(const uint32_t* host_bits, size_t n_words) {
+#if defined(STRATA_GPU_METAL)
+    (void) host_bits; (void) n_words;
+    return false;
+#else
+    if (next_ != nullptr) (void) next_->update_warm_bitmap(host_bits, n_words);
+    if (rsm_warm_ == nullptr || host_bits == nullptr || n_words == 0 || rsm_warm_words_ == 0) return false;
