diff --git a/engine/src/kernels/cpu/iq512_exact_gu_test.cpp b/engine/src/kernels/cpu/iq512_exact_gu_test.cpp
new file mode 100644
index 000000000..3ab25bea1
--- /dev/null
+++ b/engine/src/kernels/cpu/iq512_exact_gu_test.cpp
@@ -0,0 +1,149 @@
+// Default IQ rows vs the opt-in fused rows: synthetic blocks, no model or GPU.
+// --bench times the same two entry points, interleaved, with a DRAM-sized arena.
+#include "strata/kernels/cpu/expert_layout.hpp"
+#include "strata/kernels/cpu/iq_avx512.hpp"
+#include "strata/kernels/cpu/native_expert.hpp"
+#include "ggml.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace cpu = strata::kernels::cpu;
+namespace {
+constexpr int width = 8;
+using Clock = std::chrono::steady_clock;
+
+struct Fixture {
+    cpu::NativeFmt fmt;
+    std::vector<uint8_t> blob;
+    std::array<std::vector<uint8_t>, width> act;
+    std::array<std::vector<float>, width> ref, opt, dispatch;
+    const void* ap[width];
+    float *rp[width], *op[width], *dp[width];
+
+    bool init(int type, int n, int ff, std::mt19937& rng) {
+        std::string err;
+        if (!cpu::native_fmt(type, 20, n, ff, fmt, err)) {
+            std::fprintf(stderr, "%s\n", err.c_str());
+            return false;
+        }
+        blob.resize(fmt.bytes);
+        for (auto& b : blob) b = static_cast<uint8_t>(rng());
+        const size_t block = ggml_type_size(static_cast<ggml_type>(type));
+        // Only finite fp16 block scales, including zero, signed and subnormal.
+        const uint16_t scales[] = {0, 1, 0x9400, 0x2400, 0x3000, 0x3800};
+        for (size_t at = 0; at < fmt.down_off; at += block) {
+            const uint16_t d = scales[rng() % 6];
+            std::memcpy(blob.data() + at, &d, sizeof d);
+        }
+        for (int t = 0; t < width; ++t) {
+            act[t].resize(fmt.act_bytes);
+            ref[t].resize(ff); opt[t].resize(ff); dispatch[t].resize(ff);
+            ap[t] = act[t].data(); rp[t] = ref[t].data();
+            op[t] = opt[t].data(); dp[t] = dispatch[t].data();
+        }
+        return true;
+    }
+    void activations(std::mt19937& rng, float amp) {
+        std::vector<float> x(fmt.n_embd);
+        for (int t = 0; t < width; ++t) {
+            for (auto& v : x) v = (int(rng() % 2049) - 1024) * amp / 1024.f;
+            cpu::native_quant_act(fmt, x.data(), act[t].data());
+        }
+    }
+    void rows(bool exact, const uint8_t* w, int nt, float* const* out, int r0, int r1) {
+        auto kernel = exact ? cpu::iq512_exact_gu_rows : cpu::iq512_gu_rows;
+        kernel(fmt.gu_type, w, fmt.gu_row, fmt.up_off, (int) fmt.n_embd, ap, nt, out, r0, r1);
+    }
+};
+
+bool parity(std::mt19937& rng) {
+    size_t values = 0;
+    for (int type : {16, 17, 18, 21, 22}) {
+        for (int n : {256, 512, 768, 1792, 2048}) {
+            constexpr int ff = 256;
+            Fixture f;
+            if (!f.init(type, n, ff, rng)) return false;
+            for (float amp : {0.f, .01f, .3f, 3.f}) {
+                f.activations(rng, amp);
+                for (int nt = 1; nt <= width; ++nt) {
+                    for (auto* rows : {&f.ref, &f.opt, &f.dispatch})
+                        for (auto& v : *rows) std::fill(v.begin(), v.end(), -12345.f);
+                    // Full reference, candidate through non-aligned task boundaries.
+                    f.rows(false, f.blob.data(), nt, f.rp, 0, ff);
+                    f.rows(true, f.blob.data(), nt, f.op, 0, 7);
+                    f.rows(true, f.blob.data(), nt, f.op, 7, 131);
+                    f.rows(true, f.blob.data(), nt, f.op, 131, ff);
+                    cpu::native_gu_rows(f.fmt, f.blob.data(), f.ap, nt, f.dp, 0, ff);
+                    for (int t = 0; t < width; ++t) {
+                        if (t < nt) values += ff;
+                        for (int r = 0; r < ff; ++r) {
+                            const float a = f.ref[t][r], b = f.opt[t][r], c = f.dispatch[t][r];
+                            if (!std::isfinite(a) || std::memcmp(&a, &b, 4) || std::memcmp(&a, &c, 4)
+                                || (t >= nt && a != -12345.f)) {
+                                std::fprintf(stderr, "mismatch: type=%d K=%d nt=%d token=%d row=%d amp=%g\n",
+                                             type, n, nt, t, r, amp);
+                                return false;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    std::printf("PASS: %zu active gate/up values, bit-identical (direct + native dispatch), all five IQ types, 1..8 tokens\n", values);
+    return true;
+}
+
+bool bench(std::mt19937& rng, int experts) {
+    constexpr int n = 2048, ff = 768;
+    std::puts("type,nt,experts,round,baseline_ms,exact_ms");
+    for (int type : {16, 17, 18, 21, 22}) {
+        Fixture f;
+        if (!f.init(type, n, ff, rng)) return false;
+        f.activations(rng, .3f);
+        // Distinct physical weights; same inputs and rows in both arms.
+        const size_t stride = (f.fmt.down_off + 4095) / 4096 * 4096;
+        std::vector<uint8_t> arena(stride * experts);
+        for (int e = 0; e < experts; ++e)
+            std::memcpy(arena.data() + stride * e, f.blob.data(), f.fmt.down_off);
+        for (int nt : {1, 2, 3, 4, 8}) {
+            auto run = [&](bool exact) {
+                auto start = Clock::now();
+                for (int e = 0; e < experts; ++e)
+                    f.rows(exact, arena.data() + stride * e, nt, f.op, 0, ff);
+                return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+            };
+            run(false); run(true);
+            for (int r = 0; r < 5; ++r) {
+                double a, b;
+                if (r % 2 == 0) { a = run(false); b = run(true); }
+                else { b = run(true); a = run(false); }
+                std::printf("%d,%d,%d,%d,%.5f,%.5f\n", type, nt, experts, r, a, b);
+                std::fflush(stdout);
+            }
+        }
+    }
+    return true;
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    // This TU is compiled at the baseline ISA. Never enter the wide file on
+    // a CPU lacking VNNI; the exact path itself checks VPOPCNTDQ.
+    if (!cpu::cpu_vnni_ok() || !cpu::iq512f_supported(18)) {
+        std::puts("SKIP: AVX-512 VNNI + VPOPCNTDQ required");
+        return 77;
+    }
+    if (argc > 2 || (argc == 2 && std::strcmp(argv[1], "--bench"))) return 2;
+    std::mt19937 rng(20261124);
+    if (!parity(rng)) return 1;
+    if (argc == 2 && !bench(rng, 192)) return 1;
+    return 0;
+}
