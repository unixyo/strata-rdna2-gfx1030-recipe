+void iq512_exact_gu_rows(int type, const uint8_t* blob, size_t gu_row, size_t up_off, int n, const void* const* act, int nt,
+                   float* const* ff, int r0, int r1) {
+    // Opt-in only on CPUs with VPOPCNTDQ. For small groups, share activation
+    // loads but keep each projection's original sixteen-lane accumulation.
+    // Wider groups use separate projections to avoid excessive register use.
+    // IQ2_S retains the original path: no consistent gain on the measured Zen 4.
+    if (has_vpopcnt()) {
