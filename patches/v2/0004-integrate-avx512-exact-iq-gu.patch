+            switch (type) {
+                case 16: gu_fused_default_nt<16>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+                case 17: gu_fused_default_nt<17>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+                case 18: gu_fused_default_nt<18>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+                case 21: gu_fused_default_nt<21>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+            }
+        }
+        switch (type) {
+            case 16: gu_rows_nt<16, false, true>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+            case 17: gu_rows_nt<17, false, true>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+            case 18: gu_rows_nt<18, false, true>(nt, blob, gu_row, up_off, n, act, ff, r0, r1); return;
+        }
+    }
+    iq512_gu_rows(type, blob, gu_row, up_off, n, act, nt, ff, r0, r1);
+}
