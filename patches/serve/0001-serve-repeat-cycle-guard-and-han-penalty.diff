+def repeated_token_cycle(ids, min_span=REPEAT_CYCLE_STOP_TOKENS):
+    """Return (period, repeats, span) for a pathological exact suffix cycle, else None."""
+    if not min_span or len(ids) < min_span:
+        return None
+    upto = min(REPEAT_CYCLE_MAX_PERIOD, len(ids) // REPEAT_CYCLE_MIN_REPEATS)
+    for period in range(1, upto + 1):
+        repeats = max(REPEAT_CYCLE_MIN_REPEATS, (min_span + period - 1) // period)
+        span = period * repeats
+        if len(ids) < span:
+            continue
+        block = ids[-period:]
+        if all(ids[-r * period:-(r - 1) * period if r > 1 else None] == block
+               for r in range(2, repeats + 1)):
+            return period, repeats, span
+    return None
+
