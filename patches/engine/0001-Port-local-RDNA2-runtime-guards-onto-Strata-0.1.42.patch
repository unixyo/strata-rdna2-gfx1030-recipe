diff --git a/tools/han_soft_mask.py b/tools/han_soft_mask.py
new file mode 100644
index 000000000..acd439c8e
--- /dev/null
+++ b/tools/han_soft_mask.py
@@ -0,0 +1,77 @@
+#!/usr/bin/env python3
+"""Generate the compact Han-token bitset used by the native sampler.
+
+Only tokens whose individual decoded text contains Han or a CJK iteration mark
+are marked. Byte-fallback pieces are intentionally left alone so Korean, emoji,
+and unrelated UTF-8 sequences are not penalized.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import strata_tokenizer as ST  # noqa: E402
+
+
+def is_han_char(ch: str) -> bool:
+    cp = ord(ch)
+    return (
+        0x3400 <= cp <= 0x4DBF
+        or 0x4E00 <= cp <= 0x9FFF
+        or 0xF900 <= cp <= 0xFAFF
+        or 0x20000 <= cp <= 0x2FA1F
+        or cp in (0x3005, 0x3006, 0x303B)
+    )
+
+
+def tokenizer_at(path: Path) -> tuple[ST.Tokenizer, int]:
+    vocab = json.loads((path / "vocab.json").read_text(encoding="utf-8"))
+    tokens = [None] * len(vocab)
+    for text, token_id in vocab.items():
+        tokens[token_id] = text
+    merges = (path / "merges.txt").read_text(encoding="utf-8").split("\n")
+    types = json.loads((path / "token_type.json").read_text(encoding="utf-8"))
+    return ST.Tokenizer(tokens, merges, types), len(tokens)
+
+
+def build_mask(tok: ST.Tokenizer, vocab: int) -> tuple[list[int], list[int]]:
+    ids: list[int] = []
+    words = [0] * ((vocab + 31) // 32)
+    for token_id in range(vocab):
+        decoded = tok.decode([token_id])
+        if any(is_han_char(ch) for ch in decoded):
+            ids.append(token_id)
+            words[token_id >> 5] |= 1 << (token_id & 31)
+    return ids, words
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tokenizer", required=True, type=Path)
+    ap.add_argument("--out", required=True, type=Path)
+    args = ap.parse_args()
+
+    tok, vocab = tokenizer_at(args.tokenizer)
+    ids, words = build_mask(tok, vocab)
+    lines = [
+        "// Generated by tools/han_soft_mask.py. Do not edit by hand.",
+        f"#define STRATA_HAN_MASK_VOCAB {vocab}",
+        f"#define STRATA_HAN_MASK_WORDS {len(words)}",
+        f"#define STRATA_HAN_MASK_COUNT {len(ids)}",
+        "",
+    ]
+    for i in range(0, len(words), 8):
+        chunk = ", ".join(f"0x{x:08x}u" for x in words[i:i + 8])
+        lines.append(chunk + ("," if i + 8 < len(words) else ""))
+    args.out.write_text("\n".join(lines) + "\n", encoding="utf-8")
+    print(f"vocab={vocab} han_tokens={len(ids)} words={len(words)} out={args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
