diff --git a/include/strata/kernels/sampler.hpp b/include/strata/kernels/sampler.hpp
index a3121ba1f..08b7f293b 100644
--- a/include/strata/kernels/sampler.hpp
+++ b/include/strata/kernels/sampler.hpp
@@ -22,6 +22,7 @@ struct SamplerParams {
